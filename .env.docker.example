# Docker Compose 环境变量示例
# Coolify：在应用的环境变量页面填写以下值
# 本地校验：docker compose --env-file .env.docker.example config

# ==============================================================================
# Home Assistant Configuration
# ==============================================================================

# 必填：平板浏览器和 Coolify 容器均可访问的 Home Assistant 地址
# Fusion 使用 HTTPS 时，HA 也必须使用 HTTPS，以支持登录和 WebSocket
# 不要使用仅 Docker 内部可解析的服务名
HASS_URL=https://ha.example.com

# ==============================================================================
# General Settings
# ==============================================================================

# 容器时区（生产环境默认 Asia/Shanghai）
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Asia/Shanghai

# ==============================================================================
# Production Settings (docker-compose.yml)
# ==============================================================================

# Fusion 对外访问地址：与 Coolify 中绑定的域名一致，不带末尾斜杠
ORIGIN=https://fusion.example.com

# 宿主机访问端口；Coolify 域名代理仍使用容器端口 5050
# 若服务器已占用 5050，可改为其他空闲端口
EXPOSED_PORT=5050

# 应用设置保存在 ha-fusion-data 命名卷中，挂载到 /app/data
# 布局由仓库 data/dashboard.yaml 管理，新部署会覆盖网页保存的布局修改

# ==============================================================================
# Development Settings (docker-compose.dev.yml)
# ==============================================================================

# Port for Vite dev server (optional, defaults to 5173)
DEV_PORT=5173
