# This file is only for development, environment should be
# set in docker, and when using addon `hassUrl` is irrelevant.

HASS_URL=http://homeassistant.local:8123

# 可选的 Immich 相册，密钥仅服务端使用，需要 album.read、asset.read 和 asset.view 权限。
# 填写 Immich 根地址或以 /api 结尾的地址，可使用家庭内网地址；仅部署在可信内网。
IMMICH_URL=
IMMICH_API_KEY=
IMMICH_ALBUM_ID=
